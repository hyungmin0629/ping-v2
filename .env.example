# =====================================================================
# .env.example · 환경변수 서식
# =====================================================================
# 사용법:
#   1. 이 파일을 복사해서 .env 로 이름을 바꾼다
#        Windows:  copy .env.example .env
#   2. .env 안의 값을 실제 값으로 채운다
#   3. .env 는 .gitignore 에 들어 있어 커밋되지 않는다
#
# ⚠️ 이 파일(.env.example)에는 진짜 키를 적지 않는다.
#    여기 적힌 것은 "어떤 값이 필요한지"를 알려주는 서식일 뿐이다.
# =====================================================================


# ---------------------------------------------------------------------
# 로컬 Postgres — 합성 데이터 전용
# ---------------------------------------------------------------------
# docker run -d --name pgtest -e POSTGRES_PASSWORD=test \
#   -e POSTGRES_DB=pingv2 -p 5433:5432 postgres:16
PGHOST=localhost
PGPORT=5433
PGDATABASE=pingv2
PGUSER=postgres
PGPASSWORD=test


# ---------------------------------------------------------------------
# Supabase — 실유저 전용 (웹앱 트랙 시작 시 채운다)
# ---------------------------------------------------------------------
# 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon key: 브라우저에 노출되는 공개 키. RLS 정책이 이 키를 막아준다.
SUPABASE_ANON_KEY=

# service_role key: RLS를 통째로 무시하는 마스터 키.
# ⚠️ 절대 브라우저·프론트엔드 코드에 넣지 말 것. 서버/Airflow에서만 사용.
SUPABASE_SERVICE_KEY=

# Airflow가 직접 붙을 때 쓰는 연결 문자열
# 대시보드 > Project Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres


# ---------------------------------------------------------------------
# NEIS 교육정보 개방포털
# ---------------------------------------------------------------------
# https://open.neis.go.kr 에서 무료 발급
NEIS_API_KEY=


# ---------------------------------------------------------------------
# Google Cloud / BigQuery
# ---------------------------------------------------------------------
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_DATASET_RAW=raw
BQ_DATASET_STG=stg
BQ_DATASET_MART=mart
BQ_LOCATION=asia-northeast3

# 서비스 계정 키 파일 경로 (이 파일도 커밋 금지)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json


# ---------------------------------------------------------------------
# 합성 데이터 생성 파라미터
# ---------------------------------------------------------------------
SYNTHETIC_USER_COUNT=5000
SYNTHETIC_MONTHS=3
SYNTHETIC_SCHOOL_COUNT=300

# 같은 시드를 쓰면 같은 데이터가 나온다(재현성). 바꾸면 다른 데이터가 나온다.
SYNTHETIC_SEED=20260729
