# =====================================================================
# 비밀정보 — 절대 커밋 금지
# =====================================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json
gcp-key*.json


# =====================================================================
# 생성 데이터 — 용량이 크고 언제든 다시 만들 수 있다
# =====================================================================
data/synthetic/
generator/output/
*.csv
*.parquet
*.dump
*.sql.gz
!db/ddl/*.sql
!bigquery/**/*.sql
!qa/checks/*.sql


# =====================================================================
# 품질 리포트 — 실행할 때마다 쌓인다
# =====================================================================
qa/reports/*.md
qa/reports/*.json
!qa/reports/.gitkeep


# =====================================================================
# Python
# =====================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/


# =====================================================================
# Airflow
# =====================================================================
airflow/logs/
airflow/plugins/__pycache__/
airflow.db
airflow.cfg
webserver_config.py
standalone_admin_password.txt


# =====================================================================
# OS / 편집기
# =====================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
.idea/
*.swp
*~


# =====================================================================
# Obsidian — 설정은 공유하고, 작업 상태는 공유하지 않는다
# =====================================================================
# graph.json(그래프 색·물리) · core-plugins.json(켠 기능) · app.json(제외 필터)
# 은 팀이 같은 화면을 보게 하므로 커밋한다.
# workspace 는 "지금 어느 탭을 열어뒀나"라서 사람마다 다르고, 공유하면
# 서로의 창 배치를 덮어쓴다.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json
